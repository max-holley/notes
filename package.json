{
  "name": "notes",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0 && node scripts/audit-style.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit:brand": "node scripts/audit-brand.mjs",
    "verify": "node scripts/verify.mjs",
    "new:service": "node scripts/new-service.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "serve:mock": "node scripts/serve-mock.mjs",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
